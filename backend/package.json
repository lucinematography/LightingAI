{"name":"lighting-ai-backend","version":"1.0.0","type":"module","scripts":{"start":"node server.js","validate:catalog":"node -e \"import('./catalog-validation.js').then(({validateCatalog})=>{const r=validateCatalog(); console.log(JSON.stringify(r,null,2)); if(!r.ok) process.exit(1);})\"","test:catalog":"node catalog-selftest.js","audit:sources":"node source-audit.js","catalog:status":"node -e \"import('./catalog-status.js').then(({catalogStatus})=>console.log(JSON.stringify(catalogStatus(),null,2)))\"","check":"npm run validate:catalog && npm run test:catalog && npm run audit:sources"},"dependencies":{"cors":"^2.8.5","dotenv":"^16.4.5","express":"^4.21.1","openai":"^4.77.0"}}
