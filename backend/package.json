{"name":"lighting-ai-backend","version":"1.0.0","type":"module","scripts":{"start":"node server.js","validate:catalog":"node -e \"import('./catalog-validation.js').then(({validateCatalog})=>{const r=validateCatalog(); console.log(JSON.stringify(r,null,2)); if(!r.ok) process.exit(1);})\"","test:catalog":"node catalog-selftest.js","test:ls":"node ls-compatibility-selftest.js","test:storm":"node storm-compatibility-selftest.js","test:storm:photometrics":"node storm-photometric-selftest.js","test:electro":"node electro-storm-selftest.js","test:aputure:complete":"node aputure-completion-selftest.js","test:aputure:review":"node aputure-review-selftest.js","audit:sources":"node source-audit.js","catalog:status":"node -e \"import('./catalog-status.js').then(({catalogStatus})=>console.log(JSON.stringify(catalogStatus(),null,2)))\"","check":"npm run validate:catalog && npm run test:catalog && npm run test:ls && npm run test:storm && npm run test:storm:photometrics && npm run test:electro && npm run test:aputure:complete && npm run test:aputure:review && npm run audit:sources"},"dependencies":{"cors":"^2.8.5","dotenv":"^16.4.5","express":"^4.21.1","openai":"^4.77.0"}}
